<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <!-- ================================
         تنظیمات پایه
    ================================= -->

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="محمد امین‌زاده — پیانیست، آهنگساز، توسعه‌دهنده وب و طراح لوگو. تبدیل احساسات به موسیقی، ایده‌ها به طراحی و مفاهیم به تجربه‌های دیجیتال."
    />

    <meta name="author" content="محمد امین‌زاده" />

    <meta
      name="keywords"
      content="محمد امین‌زاده, پیانیست, آهنگساز, توسعه‌دهنده وب, طراح لوگو, برند شخصی, وب دولوپر ایرانی"
    />

    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta name="googlebot" content="index, follow" />

    <meta name="theme-color" content="#0d0d0d" />

    <!--
        نشانی مرجع (Canonical)
        اگر این نسخه‌ی فارسی رو توی یه مسیر جدا (مثلاً /fa/) میزبانی می‌کنی،
        این نشانی رو با نشانی واقعی همون مسیر جایگزین کن.
    -->

    <link rel="canonical" href="https://mohammadaminzaadeh.github.io/fa/" />

    <!--
        نسخه‌های زبانی (hreflang)
        این تگ‌ها به گوگل می‌گن نسخه‌ی انگلیسی و فارسی سایتت به هم مرتبط‌ان،
        تا هرکاربر نسخه‌ی مناسب زبان خودش رو توی نتایج جستجو ببینه.
        نشانی‌ها رو با ساختار واقعی هاستینگت (مثلاً /fa/) هماهنگ کن.
    -->

    <link
      rel="alternate"
      hreflang="en"
      href="https://mohammadaminzaadeh.github.io/"
    />
    <link
      rel="alternate"
      hreflang="fa"
      href="https://mohammadaminzaadeh.github.io/fa/"
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href="https://mohammadaminzaadeh.github.io/"
    />

    <title>محمد امین‌زاده | پیانیست، طراح و توسعه‌دهنده وب</title>

    <!-- ================================
         اپن‌گراف / فیسبوک / لینکدین
    ================================= -->

    <meta property="og:type" content="website" />

    <meta
      property="og:url"
      content="https://mohammadaminzaadeh.github.io/fa/"
    />

    <meta
      property="og:title"
      content="محمد امین‌زاده | پیانیست، طراح و توسعه‌دهنده وب"
    />

    <meta
      property="og:description"
      content="محمد امین‌زاده — پیانیست، آهنگساز، توسعه‌دهنده وب و طراح لوگو. تبدیل احساسات به موسیقی، ایده‌ها به طراحی و مفاهیم به تجربه‌های دیجیتال."
    />

    <meta
      property="og:image"
      content="https://mohammadaminzaadeh.github.io/images/mohammad-aminzadeh-1.jpg"
    />

    <meta property="og:image:alt" content="محمد امین‌زاده" />

    <meta property="og:site_name" content="محمد امین‌زاده" />

    <meta property="og:locale" content="fa_IR" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- ================================
         توییتر کارت
    ================================= -->

    <meta name="twitter:card" content="summary_large_image" />

    <meta
      name="twitter:title"
      content="محمد امین‌زاده | پیانیست، طراح و توسعه‌دهنده وب"
    />

    <meta
      name="twitter:description"
      content="محمد امین‌زاده — پیانیست، آهنگساز، توسعه‌دهنده وب و طراح لوگو. تبدیل احساسات به موسیقی، ایده‌ها به طراحی و مفاهیم به تجربه‌های دیجیتال."
    />

    <meta
      name="twitter:image"
      content="https://mohammadaminzaadeh.github.io/images/mohammad-aminzadeh-1.jpg"
    />

    <!-- ================================
         فونت آراد (Arad Medium)

         آراد یه فونت فارسیه که روی گوگل‌فونتس نیست، پس نمی‌شه از CDN لودش کرد.
         اگه فایل فونت (woff2) رو داری، این بلاک رو از کامنت خارج کن
         و مسیر فایل رو با مسیر واقعیش جایگزین کن:

         @font-face {
           font-family: 'Arad';
           src: url('./fonts/Arad-Medium.woff2') format('woff2');
           font-weight: 500;
           font-display: swap;
         }

         تا وقتی فایل فونت رو اضافه نکردی، فونت «وزیرمتن» (Vazirmatn) به‌عنوان
         جایگزین رایگان و باکیفیت از گوگل‌فونتس لود می‌شه تا سایت بدون فونت
         خراب نشه.
    ================================= -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- ================================
         کل CSS
    ================================= -->

    <style>
      /* =================================
           متغیرها — دقیقاً همون رنگ‌های برند
        ================================= */

      :root {
        --black: #0d0d0d;
        --black-soft: #111111;
        --black-card: #171717;
        --gold: #d4af37;
        --gold-light: #e5c65a;
        --white: #ffffff;
        --gray: #a4a4a4;
        --gray-dark: #777777;
        --border: rgba(255, 255, 255, 0.09);
        --gold-border: rgba(212, 175, 55, 0.3);
        --max-width: 1180px;
        --font-fa: "AradVF";
      }

      #page-transition {
        position: fixed;
        inset: 0;
        background: var(--black);
        z-index: 9999;
        opacity: 1;
        transition: opacity 0.45s ease;
      }

      #page-transition.hide {
        opacity: 0;
        pointer-events: none;
      }

      /* =================================
           ریست
        ================================= */

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-fa);
        background: var(--black);
        color: var(--white);
        line-height: 1.9;
        overflow-x: hidden;
        text-align: right;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      .visually-hidden-skip {
        position: absolute;
        right: -9999px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
        z-index: 2000;
      }

      .visually-hidden-skip:focus {
        right: 12px;
        top: 12px;
        width: auto;
        height: auto;
        padding: 10px 16px;
        background: var(--gold);
        color: #090909;
        border-radius: 4px;
      }

      img {
        max-width: 100%;
        display: block;
      }

      /* =================================
           کانتینر اصلی
        ================================= */

      .container {
        width: 90%;
        max-width: var(--max-width);
        margin-left: auto;
        margin-right: auto;
      }

      section {
        padding: 110px 0;
      }

      .gold {
        color: var(--gold);
      }

      .section-label {
        color: var(--gold);
        font-weight: 600;
        font-size: 16px;
        margin-bottom: 16px;
      }

      .section-title {
        font-weight: 700;
        font-size: clamp(2.2rem, 5vw, 3.7rem);
        line-height: 1.35;
        margin-bottom: 25px;
      }

      .section-description {
        color: var(--gray);
        max-width: 680px;
        font-size: 17px;
      }

      /* =================================
           نوار بالا
        ================================= */

      header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        background: rgba(13, 13, 13, 0.82);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border-bottom: 1px solid var(--border);
      }

      nav {
        height: 78px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo {
        font-size: 21px;
        font-weight: 700;
      }

      .logo span {
        color: var(--gold);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 30px;
        list-style: none;
      }

      .nav-links a {
        color: #d0d0d0;
        font-size: 15px;
        font-weight: 500;
        transition: 0.3s ease;
      }

      .nav-links a:hover {
        color: var(--gold);
      }

      .nav-button {
        padding: 10px 19px;
        border: 1px solid var(--gold);
        color: var(--gold) !important;
      }

      .nav-button:hover {
        background: var(--gold);
        color: #090909 !important;
      }

      .lang-switch {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--gray-dark);
      }

      .lang-switch a {
        transition: color 0.25s ease;
      }

      .lang-switch a.active {
        color: var(--gold);
        font-weight: 600;
      }

      .lang-switch a:not(.active):hover {
        color: var(--gold);
      }

      .lang-switch .divider {
        color: var(--border);
      }

      /* =================================
           هیرو
        ================================= */

      .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
        padding-top: 120px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        align-items: center;
        gap: 80px;
      }

      .hero-small {
        color: var(--gray);
        font-size: 15px;
        font-weight: 400;
        margin-bottom: 22px;
      }

      .hero h1 {
        font-weight: 700;
        font-size: clamp(2.8rem, 6.5vw, 5.2rem);
        line-height: 1.25;
        margin-bottom: 30px;
      }

      .hero-description {
        color: #aaa;
        font-size: 18px;
        max-width: 600px;
        margin-bottom: 38px;
      }

      .hero-buttons {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 28px;
        font-weight: 600;
        font-size: 15px;
        transition: 0.3s ease;
      }

      .btn-primary {
        background: var(--gold);
        color: #090909;
      }

      .btn-primary:hover {
        background: var(--gold-light);
        transform: translateY(-3px);
      }

      .btn-outline {
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
      }

      .btn-outline:hover {
        border-color: var(--gold);
        color: var(--gold);
        transform: translateY(-3px);
      }

      /* =================================
           پرتره‌ی هیرو
        ================================= */

      .hero-visual {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .portrait-frame {
        width: min(400px, 82vw);
        aspect-ratio: 4 / 5;
        border: 1px solid var(--gold-border);
        padding: 10px;
        position: relative;
      }

      .portrait-inner {
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
        background: #181818;
      }

      .portrait-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
      }

      .portrait-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to top,
          rgba(0, 0, 0, 0.78),
          rgba(0, 0, 0, 0.04) 65%
        );
        pointer-events: none;
      }

      .portrait-text {
        position: absolute;
        bottom: 25px;
        right: 25px;
        text-align: right;
        z-index: 2;
      }

      .portrait-text strong {
        display: block;
        font-weight: 700;
        font-size: 24px;
      }

      .portrait-text span {
        color: var(--gold);
        font-size: 13px;
      }

      .floating-card {
        position: absolute;
        bottom: 25px;
        left: -45px;
        background: rgba(24, 24, 24, 0.92);
        backdrop-filter: blur(15px);
        border: 1px solid var(--border);
        padding: 17px 20px;
        min-width: 180px;
        z-index: 5;
        text-align: right;
      }

      .floating-card span {
        display: block;
        color: var(--gray);
        font-size: 12px;
        margin-bottom: 4px;
      }

      .floating-card strong {
        color: var(--gold);
        font-size: 15px;
        font-weight: 700;
      }

      /* =================================
           درباره من
        ================================= */

      .about {
        background: var(--black-soft);
      }

      .about-grid {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        gap: 90px;
        align-items: center;
      }

      .about-image {
        width: 100%;
        max-width: 430px;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        border: 1px solid var(--gold-border);
        padding: 10px;
      }

      .about-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
      }

      .about-content p {
        color: #aaa;
        font-size: 17px;
        margin-bottom: 18px;
      }

      .signature {
        margin-top: 35px;
        font-weight: 700;
        font-size: 24px;
        color: var(--gold);
      }

      /* =================================
           تخصص
        ================================= */

      .services-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-top: 55px;
      }

      .service-card {
        background: var(--black-card);
        border: 1px solid var(--border);
        padding: 35px 27px;
        transition: 0.35s ease;
        position: relative;
        overflow: hidden;
      }

      .service-card::before {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 2px;
        background: var(--gold);
        transform: scaleX(0);
        transform-origin: right;
        transition: 0.35s ease;
      }

      .service-card:hover {
        transform: translateY(-8px);
        border-color: var(--gold-border);
      }

      .service-card:hover::before {
        transform: scaleX(1);
      }

      .service-icon {
        display: inline-flex;
        margin-bottom: 22px;
      }

      .service-icon svg {
        display: block;
      }

      .service-card h3 {
        font-weight: 700;
        font-size: 20px;
        margin-bottom: 12px;
      }

      .service-card p {
        color: #888;
        font-size: 14.5px;
      }

      /* =================================
           نمونه‌کار
        ================================= */

      .work {
        background: var(--black-soft);
      }

      .work-grid {
        width: 100%;
        max-width: 100%;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
        margin-top: 55px;
      }

      .work-card {
        min-width: 0;
        width: 100%;
        min-height: 300px;
        display: block;
        border: 1px solid var(--border);
        background: var(--black-card);
        padding: 35px;
        position: relative;
        overflow: hidden;
        transition: 0.35s ease;
      }

      .work-card:hover {
        transform: translateY(-7px);
        border-color: var(--gold-border);
      }

      .work-category {
        color: var(--gold);
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 70px;
      }

      .work-card h3 {
        font-weight: 700;
        font-size: 26px;
        margin-bottom: 10px;
      }

      .work-card p {
        color: #888;
        max-width: 450px;
      }

      /* =================================
           فلسفه‌ی کاری
        ================================= */

      .philosophy {
        text-align: center;
      }

      .quote {
        max-width: 900px;
        margin: 30px auto 0;
        font-weight: 700;
        font-size: clamp(1.7rem, 4.5vw, 3.4rem);
        line-height: 1.6;
      }

      /* =================================
           تماس
        ================================= */

      .contact {
        background: var(--black-soft);
      }

      .contact-box {
        border: 1px solid var(--gold-border);
        padding: 65px;
        text-align: center;
        position: relative;
        overflow: hidden;
      }

      .contact-box > * {
        position: relative;
        z-index: 2;
      }

      .contact-box h2 {
        font-weight: 700;
        font-size: clamp(2rem, 4.5vw, 3.4rem);
        line-height: 1.4;
        margin-bottom: 18px;
      }

      .contact-box p {
        color: #999;
        max-width: 600px;
        margin: 0 auto 30px;
      }

      /* =================================
           فوتر
        ================================= */

      footer {
        padding: 30px 0;
        border-top: 1px solid var(--border);
      }

      .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
      }

      .footer-content p {
        color: #777;
        font-size: 13px;
      }

      .socials {
        display: flex;
        gap: 20px;
      }

      .socials a {
        color: #888;
        font-size: 13px;
        transition: 0.3s ease;
      }

      .socials a:hover {
        color: var(--gold);
      }

      /* =================================
           تبلت
        ================================= */

      @media (max-width: 950px) {
        .hero-grid {
          grid-template-columns: 1fr;
          gap: 60px;
        }
        .hero-content {
          text-align: center;
        }
        .hero-description {
          margin-left: auto;
          margin-right: auto;
        }
        .hero-buttons {
          justify-content: center;
        }
        .hero-visual {
          margin-bottom: 30px;
        }
        .about-grid {
          grid-template-columns: 1fr;
          gap: 50px;
        }
        .about-image {
          margin: 0 auto;
        }
        .services-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      /* =================================
           موبایل
        ================================= */

      @media (max-width: 650px) {
        section {
          padding: 80px 0;
        }
        nav {
          height: 70px;
        }
        .nav-links {
          display: none;
        }
        .hero {
          padding-top: 105px;
        }
        .hero h1 {
          font-size: 2.6rem;
        }
        .hero-small {
          font-size: 13px;
        }
        .hero-description {
          font-size: 16px;
        }
        .portrait-frame {
          width: 85vw;
          max-width: 380px;
        }
        .floating-card {
          left: -5px;
          bottom: 15px;
          min-width: 160px;
          padding: 14px 16px;
        }
        .portrait-text {
          right: 18px;
          bottom: 18px;
        }
        .portrait-text strong {
          font-size: 20px;
        }
        .services-grid {
          grid-template-columns: 1fr;
        }
        .work-grid {
          grid-template-columns: 1fr;
        }
        .work-card {
          min-height: 270px;
        }
        .contact-box {
          padding: 45px 20px;
        }
        .contact-box h2 {
          font-size: 2.1rem;
        }
        .footer-content {
          flex-direction: column;
          text-align: center;
        }
      }
    </style>

    <!-- ================================
         داده‌ساختاریافته (Schema.org)
         به گوگل کمک می‌کنه بفهمه این سایت درباره‌ی کیه
    ================================= -->

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "محمد امین‌زاده",
        "alternateName": "mohammadaminzaadeh",
        "url": "https://mohammadaminzaadeh.github.io/fa/",
        "image": "https://mohammadaminzaadeh.github.io/images/mohammad-aminzadeh-1.jpg",
        "jobTitle": ["توسعه‌دهنده وب", "پیانیست", "آهنگساز", "طراح لوگو"],
        "description": "محمد امین‌زاده — پیانیست، آهنگساز، توسعه‌دهنده وب و طراح لوگو. تبدیل احساسات به موسیقی، ایده‌ها به طراحی و مفاهیم به تجربه‌های دیجیتال.",
        "email": "mailto:mohammadaminzaadeh@gmail.com",
        "inLanguage": "fa-IR",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "مشهد",
          "addressCountry": "IR"
        },
        "sameAs": [
          "https://www.instagram.com/mohammadaminzaadeh?igsh=eGp0aTlqdW4zMWp6",
          "https://www.behance.net/mohammaaminzad1",
          "https://github.com/MohammadAminzaadeh"
        ]
      }
    </script>
  </head>
  <body>
    <div id="page-transition"></div>
    <a href="#home" class="visually-hidden-skip">رفتن به محتوای اصلی</a>

    <!-- =================================
         نوار بالا
    ================================= -->

    <header>
      <div class="container">
        <nav aria-label="منوی اصلی">
          <a href="#home" class="logo"> محمد <span>امین‌زاده</span> </a>

          <ul class="nav-links">
            <li><a href="#about">درباره من</a></li>
            <li><a href="#services">تخصص</a></li>
            <li><a href="#work">نمونه‌کار</a></li>
            <li>
              <a href="#contact" class="nav-button">بیایید در ارتباط باشیم</a>
            </li>
          </ul>
          <div class="lang-switch">
            <a href="index.html">EN</a>
            <span class="divider">/</span>
            <a href="index-fa.html" class="active">FA</a>
          </div>
        </nav>
      </div>
